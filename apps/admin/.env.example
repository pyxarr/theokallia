# Public URL of the admin app (used for the Better Auth client origin)
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Internal NestJS API base URL (proxy target)
API_URL=http://localhost:3333

# Cloudinary base URL for image optimization (e.g. https://res.cloudinary.com/<cloud_name>/image/upload)
NEXT_PUBLIC_CLOUDINARY_BASE_URL=
