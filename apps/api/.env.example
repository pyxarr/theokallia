# App
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:3000

# Admin app origin — Better Auth must trust it for the dashboard to send
# mutating requests (PATCH/POST/DELETE) through the API proxy
ADMIN_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full

# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3333

# Redis
REDIS_URL=rediss://default:password@host:6379

# Rate limiting (Upstash REST API credentials — from Upstash console)
UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# Internal alert recipient (VIP notifications, etc). Optional, defaults to hello@theokallia.com
ADMIN_ALERT_EMAIL=hello@theokallia.com

# Resend (transactional email + audience sync)
RESEND_API_KEY=re_your_api_key
# Optional: when set, subscribers are mirrored to this Resend audience
RESEND_AUDIENCE_ID=

# Seed (optional)
SEED_API_URL=
SEED_ACCESS_TOKEN=
